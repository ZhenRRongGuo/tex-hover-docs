{
  "name": "tex-hover-docs",
  "displayName": "TeX Hover Docs",
  "description": "Show hover documentation for custom LaTeX classes, Beamer themes, and options documented in .cls and .sty files.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.146.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "latex",
    "tex",
    "beamer",
    "hover",
    "documentation"
  ],
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:tex"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "TeX Hover Docs",
      "properties": {
        "texHoverDocs.kpsewhichPath": {
          "type": "string",
          "default": "kpsewhich",
          "description": "Path to the kpsewhich executable used to find TeX files outside the workspace."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.146.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "publisher": "ZhenRGuo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZhenRRongGuo/tex-hover-docs.git"
  },
  "homepage": "https://github.com/ZhenRRongGuo/tex-hover-docs#readme",
  "bugs": {
    "url": "https://github.com/ZhenRRongGuo/tex-hover-docs/issues"
  },
  "icon": "images/icon.png"
}
